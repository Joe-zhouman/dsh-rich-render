{
  "name": "dsh-rich-render",
  "version": "0.9.8",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "link:../../vendor/schemastery",
    "@types/mdast": "^4.0.4",
    "@types/react": "^18.3.12",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "build": "node ../../node_modules/tsdown/dist/run.mjs --config tsdown.config.mjs --config-loader native",
    "build:client": "node ../../node_modules/tsdown/dist/run.mjs --config tsdown.config.mjs --config-loader native -F dsh-rich-render/client",
    "test": "node --test --experimental-strip-types test/*.test.mjs"
  }
}
